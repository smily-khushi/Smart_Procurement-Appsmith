  "text": "{{\n  (() => {\n    const pr = appsmith?.store?.selected_pr;\n    if (!pr) return \"No Requisition Selected\";\n\n    const reqNum = pr.REQUISITION_NUMBER || pr.requisition || \"PR-UNKNOWN\";\n    const rawText = pr.HEADER_NOTE || \"No Description\";\n    const cleanText = (rawText + \"\").replace(/[\\r\\n]+/g, ' ');\n    \n    const limit = 150;\n    const truncatedNote = cleanText.length > limit \n      ? cleanText.substring(0, limit).trim() + \"...\" \n      : cleanText;\n      \n    return `${reqNum} | ${truncatedNote}`;\n  })()\n}}",
  "tooltip": "{{  appsmith.store.selected_pr.requisition }} | {{appsmith.store.selected_pr.headernote || \"No Description\";\n}}",
